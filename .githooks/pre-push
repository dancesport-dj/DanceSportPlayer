#!/bin/sh
# Pre-push: ruff and the WHOLE suite, whatever the commits' scope. The
# pre-commit hook only runs the part of the suite a commit's own area can break
# (tools/dev/commit_scope.py); this is where a scoped commit that broke another area
# gets caught, before it leaves the machine.
#
# Enabled together with pre-commit by `git config core.hooksPath .githooks`.
# Skip with `git push --no-verify` only when you really mean to.

if [ -x ".venv/Scripts/python.exe" ]; then
    PY=".venv/Scripts/python.exe"
elif command -v py >/dev/null 2>&1; then
    PY="py"
else
    PY="python"
fi

if "$PY" -m ruff --version >/dev/null 2>&1; then
    echo "🧹 ruff…"
    "$PY" -m ruff check . || exit 1
else
    echo "🧹 ruff not installed — skipping lint (pip install ruff)"
fi

# Across several processes (tools/dev/parallel_suite.py): under 2 min instead of
# ~7, and a native crash is retried once instead of refusing the push. The
# runner prints the time it took, so this comment need not keep up with it.
echo "🧪 whole suite, in parallel…"
"$PY" -m tools.dev.parallel_suite || {
    echo "🛑 Suite is red — push refused."
    echo "   Fix it, or push with --no-verify if you know what you are doing."
    exit 1
}
